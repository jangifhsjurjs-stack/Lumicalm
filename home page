<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lumicalm — ความสงบเริ่มต้นที่ลมหายใจ</title>
  <meta name="description" content="Lumicalm — แอปพลิเคชันการหายใจและดูแลสุขภาพจิตด้วยคลื่นแสงและสี สร้างสภาวะผ่อนคลายอย่างลึกซึ้ง">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --sky-deep:    #020b18;
      --sky-mid:     #071829;
      --sky-horizon: #0a2540;
      --moon-core:   #ddeeff;
      --moon-glow:   #4a90c4;
      --cloud-base:  rgba(140, 185, 230, 0.22);
      --cloud-light: rgba(180, 215, 245, 0.30);
      --star-color:  rgba(200, 225, 255, 0.85);
      --accent:      #5bafd6;
      --accent-soft: rgba(91, 175, 214, 0.18);
      --text-bright: #e8f4ff;
      --text-muted:  rgba(180, 210, 240, 0.65);
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow-x: hidden;
    }

    body {
      background: var(--sky-deep);
      font-family: 'Inter', sans-serif;
      color: var(--text-bright);
      min-height: 100vh;
    }

    /* ─── Sky Background ─── */
    .sky {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%,   #0d2d50 0%, transparent 70%),
        radial-gradient(ellipse 60% 40% at 70% 10%,  #0a1e35 0%, transparent 60%),
        linear-gradient(to bottom, #020d1f 0%, #061525 40%, #0a1f35 70%, #0d2840 100%);
      z-index: 0;
    }

    /* Subtle aurora shimmer at horizon */
    .aurora {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 35vh;
      background: linear-gradient(
        to top,
        rgba(10, 35, 65, 0.70) 0%,
        rgba(14, 50, 90, 0.35) 40%,
        transparent 100%
      );
      z-index: 1;
      animation: auroraShift 22s ease-in-out infinite alternate;
    }

    @keyframes auroraShift {
      0%   { opacity: 0.5; transform: scaleX(1); }
      50%  { opacity: 0.85; transform: scaleX(1.03); }
      100% { opacity: 0.6; transform: scaleX(0.97); }
    }

    /* Subtle blue ambient glow at bottom */
    .bottom-ambient-glow {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 40vh;
      background: radial-gradient(ellipse 85% 45% at 50% 100%,
        rgba(40, 120, 190, 0.16) 0%,
        rgba(20, 70, 125, 0.07) 50%,
        transparent 85%
      );
      z-index: 1;
      pointer-events: none;
      animation: bottomGlowPulse 18s ease-in-out infinite alternate;
    }

    @keyframes bottomGlowPulse {
      0%   { opacity: 0.5; transform: scaleY(0.95); }
      50%  { opacity: 0.85; transform: scaleY(1.05); }
      100% { opacity: 0.6; transform: scaleY(0.98); }
    }

    /* Soft lower atmospheric mist layer */
    .lower-mist {
      position: fixed;
      bottom: 6vh;
      left: -10%;
      width: 120%;
      height: 240px;
      background: radial-gradient(ellipse 65% 80% at 50% 50%,
        rgba(80, 155, 215, 0.08) 0%,
        rgba(35, 95, 155, 0.03) 55%,
        transparent 80%
      );
      filter: blur(38px);
      z-index: 2;
      pointer-events: none;
      animation: lowerMistDrift 26s ease-in-out infinite alternate;
    }

    @keyframes lowerMistDrift {
      0%   { transform: translateX(-2%) translateY(0); opacity: 0.45; }
      50%  { transform: translateX(2%) translateY(-10px); opacity: 0.75; }
      100% { transform: translateX(-1%) translateY(-4px); opacity: 0.55; }
    }

    /* ─── Stars Canvas ─── */
    .stars-layer {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }

    /* Individual stars generated via CSS */
    .star {
      position: absolute;
      border-radius: 50%;
      background: var(--star-color);
      animation: twinkle var(--twinkle-dur, 5s) ease-in-out infinite alternate;
      animation-delay: var(--twinkle-delay, 0s);
    }

    @keyframes twinkle {
      0%   { opacity: var(--op-lo, 0.06); transform: scale(0.85); }
      100% { opacity: var(--op-hi, 0.55); transform: scale(1.15); }
    }

    /* ─── Moon ─── */
    .moon-wrapper {
      position: fixed;
      top: 8vh;
      left: 50%;
      transform: translateX(-50%);
      z-index: 5;
      animation: moonFloat 24s ease-in-out infinite alternate;
    }

    @keyframes moonFloat {
      0%   { transform: translateX(-50%) translateY(0px)   rotate(-1deg); }
      33%  { transform: translateX(-50%) translateY(-16px) rotate(0.5deg); }
      66%  { transform: translateX(-50%) translateY(-7px)  rotate(-0.8deg); }
      100% { transform: translateX(-50%) translateY(-20px) rotate(1deg); }
    }

    /* Soft blue atmospheric mist around moon */
    .moon-mist {
      position: absolute;
      width: 460px;
      height: 460px;
      border-radius: 50%;
      background: radial-gradient(circle at center,
        rgba(100, 185, 240, 0.13) 0%,
        rgba(50, 125, 185, 0.05) 48%,
        transparent 72%
      );
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      filter: blur(32px);
      pointer-events: none;
      animation: moonMistBreath 16s ease-in-out infinite alternate;
    }

    @keyframes moonMistBreath {
      0%   { opacity: 0.45; transform: translate(-50%, -50%) scale(0.92); }
      50%  { opacity: 0.75; transform: translate(-50%, -50%) scale(1.06); }
      100% { opacity: 0.55; transform: translate(-50%, -50%) scale(0.97); }
    }

    /* Soft diffused light rays radiating behind moon */
    .moon-light-rays {
      position: absolute;
      width: 480px;
      height: 480px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: conic-gradient(
        from 0deg at 50% 50%,
        transparent 0deg,
        rgba(155, 215, 255, 0.035) 25deg,
        transparent 55deg,
        rgba(155, 215, 255, 0.045) 90deg,
        transparent 125deg,
        rgba(155, 215, 255, 0.03) 170deg,
        transparent 210deg,
        rgba(155, 215, 255, 0.04) 260deg,
        transparent 300deg,
        rgba(155, 215, 255, 0.035) 330deg,
        transparent 360deg
      );
      border-radius: 50%;
      filter: blur(18px);
      pointer-events: none;
      animation: raysRotate 90s linear infinite;
    }

    @keyframes raysRotate {
      0%   { transform: translate(-50%, -50%) rotate(0deg); opacity: 0.65; }
      50%  { transform: translate(-50%, -50%) rotate(180deg); opacity: 0.85; }
      100% { transform: translate(-50%, -50%) rotate(360deg); opacity: 0.65; }
    }

    /* Soft celestial halo ring */
    .moon-halo-ring {
      position: absolute;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      border: 1px solid rgba(140, 210, 255, 0.11);
      box-shadow:
        0 0 35px rgba(120, 195, 245, 0.10),
        inset 0 0 35px rgba(120, 195, 245, 0.06);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      animation: haloBreath 20s ease-in-out infinite alternate;
    }

    @keyframes haloBreath {
      0%   { transform: translate(-50%, -50%) scale(0.96); opacity: 0.50; }
      50%  { transform: translate(-50%, -50%) scale(1.04); opacity: 0.80; }
      100% { transform: translate(-50%, -50%) scale(0.98); opacity: 0.60; }
    }

    .moon-glow-outer {
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle at 42% 42%,
        rgba(110, 190, 245, 0.14) 0%,
        rgba(60, 135, 195, 0.06) 45%,
        transparent 70%
      );
      display: flex;
      align-items: center;
      justify-content: center;
      animation: glowPulse 14s ease-in-out infinite alternate;
      filter: blur(1px);
      position: relative;
    }

    @keyframes glowPulse {
      0%   { transform: scale(1.00); opacity: 0.75; }
      50%  { transform: scale(1.06); opacity: 0.95; }
      100% { transform: scale(1.02); opacity: 0.80; }
    }

    .moon-glow-mid {
      position: absolute;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle at 42% 42%,
        rgba(155, 215, 255, 0.18) 0%,
        rgba(85, 160, 215, 0.09) 55%,
        transparent 75%
      );
      animation: glowPulse 16s ease-in-out infinite alternate-reverse;
      filter: blur(0.5px);
    }

    .moon {
      position: absolute;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      overflow: hidden;
      background: radial-gradient(circle at 34% 30%,
        #ffffff 0%,
        #eaf5ff 14%,
        #c8e5fb 30%,
        #9bc4e8 48%,
        #699cc8 66%,
        #3f72a2 82%,
        #1a4570 96%,
        #0f2e4d 100%
      );
      box-shadow:
        0 0 38px  rgba(150, 215, 255, 0.46),
        0 0 80px  rgba(100, 175, 235, 0.26),
        0 0 160px rgba(55, 130, 195, 0.15),
        inset -18px -16px 38px rgba(6, 26, 54, 0.42),
        inset 7px 6px 18px rgba(245, 252, 255, 0.28);
    }

    /* Soft luminous core glow inside moon */
    .moon-core-glow {
      position: absolute;
      width: 90px;
      height: 90px;
      top: 8%;
      left: 8%;
      border-radius: 50%;
      background: radial-gradient(circle at center,
        rgba(255, 255, 255, 0.35) 0%,
        rgba(220, 242, 255, 0.12) 55%,
        transparent 85%
      );
      filter: blur(8px);
      pointer-events: none;
    }

    /* Delicate rim lighting on moon edge */
    .moon-rim-light {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: inset 2.5px 2.5px 6px rgba(255, 255, 255, 0.70);
      pointer-events: none;
    }

    /* Detailed, low-contrast lunar craters & ray patterns */
    .moon::before {
      content: '';
      position: absolute;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: radial-gradient(circle at 38% 36%,
        rgba(215, 238, 255, 0.12) 0%,
        rgba(20, 50, 88, 0.22) 100%
      );
      top: 26%;
      left: 56%;
      box-shadow:
        inset 1px 1.5px 4px rgba(10, 35, 70, 0.30),
        -20px 26px 0 -4px rgba(20, 50, 88, 0.17),
        24px -14px 0 -7px rgba(20, 50, 88, 0.14),
        -32px -6px 0 -9px rgba(20, 50, 88, 0.12),
        12px 34px 0 -8px rgba(20, 50, 88, 0.13),
        -10px 48px 0 -6px rgba(20, 50, 88, 0.11),
        -28px 20px 0 -8px rgba(20, 50, 88, 0.10);
    }

    .moon-crater-details {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background:
        radial-gradient(circle at 32% 45%, rgba(255, 255, 255, 0.10) 0%, rgba(20, 50, 85, 0.15) 100%),
        radial-gradient(circle at 62% 28%, rgba(220, 242, 255, 0.08) 0%, rgba(20, 50, 85, 0.12) 100%);
      width: 18px;
      height: 18px;
      top: 60%;
      left: 36%;
      border-radius: 50%;
      box-shadow:
        inset 1px 1px 3px rgba(10, 35, 70, 0.24),
        28px -35px 0 -2px rgba(220, 242, 255, 0.08);
      pointer-events: none;
    }

    /* Soft natural surface maria / texture gradient */
    .moon-texture {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background:
        radial-gradient(ellipse 42% 32% at 65% 35%, rgba(40, 80, 125, 0.15) 0%, transparent 80%),
        radial-gradient(ellipse 52% 38% at 45% 65%, rgba(30, 70, 115, 0.13) 0%, transparent 80%),
        radial-gradient(circle at 75% 70%, rgba(25, 60, 100, 0.16) 0%, transparent 70%);
      mix-blend-mode: multiply;
      pointer-events: none;
    }

    /* Moon specular highlight */
    .moon::after {
      content: '';
      position: absolute;
      width: 64px;
      height: 40px;
      border-radius: 50%;
      background: radial-gradient(ellipse at center,
        rgba(255, 255, 255, 0.38) 0%,
        rgba(235, 248, 255, 0.15) 45%,
        transparent 70%
      );
      top: 10%;
      left: 10%;
      transform: rotate(-25deg);
      filter: blur(3px);
    }

    /* Soft translucent cloud veils crossing moon */
    .moon-cloud-veil-1 {
      position: absolute;
      width: 240px;
      height: 65px;
      border-radius: 50%;
      top: 48%;
      left: -40px;
      background: radial-gradient(ellipse at 45% 50%,
        rgba(165, 218, 250, 0.20) 0%,
        rgba(100, 175, 230, 0.08) 55%,
        transparent 85%
      );
      filter: blur(12px);
      pointer-events: none;
      z-index: 6;
      animation: moonVeil1Drift 30s ease-in-out infinite alternate;
    }

    @keyframes moonVeil1Drift {
      0%   { transform: translateX(0) translateY(0) scale(1); opacity: 0.18; }
      50%  { transform: translateX(25px) translateY(-5px) scale(1.06); opacity: 0.30; }
      100% { transform: translateX(10px) translateY(4px) scale(0.96); opacity: 0.20; }
    }

    .moon-cloud-veil-2 {
      position: absolute;
      width: 200px;
      height: 50px;
      border-radius: 50%;
      top: 26%;
      right: -35px;
      background: radial-gradient(ellipse at 55% 50%,
        rgba(140, 205, 245, 0.16) 0%,
        rgba(80, 155, 215, 0.06) 60%,
        transparent 85%
      );
      filter: blur(10px);
      pointer-events: none;
      z-index: 6;
      animation: moonVeil2Drift 36s ease-in-out infinite alternate;
    }

    @keyframes moonVeil2Drift {
      0%   { transform: translateX(0) translateY(0); opacity: 0.15; }
      50%  { transform: translateX(-20px) translateY(6px); opacity: 0.26; }
      100% { transform: translateX(-8px) translateY(-3px); opacity: 0.18; }
    }

    /* ─── Cloud System ─── */
    .clouds-layer {
      position: fixed;
      inset: 0;
      z-index: 6;
      pointer-events: none;
      overflow: hidden;
    }

    /* Individual Cloud Shape */
    .cloud {
      position: absolute;
      border-radius: 50%;
      filter: blur(var(--cloud-blur, 12px));
      animation: cloudDrift var(--drift-dur, 40s) linear infinite;
      opacity: var(--cloud-opacity, 0.55);
    }

    .cloud::before,
    .cloud::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: inherit;
    }

    @keyframes cloudDrift {
      0%   { transform: translateX(var(--start-x)) translateY(var(--wave, 0px)); }
      25%  { transform: translateX(calc(var(--start-x) + 10%)) translateY(calc(var(--wave, 0px) + 8px)); }
      50%  { transform: translateX(calc(var(--start-x) + 25%)) translateY(var(--wave, 0px)); }
      75%  { transform: translateX(calc(var(--start-x) + 40%)) translateY(calc(var(--wave, 0px) - 6px)); }
      100% { transform: translateX(calc(var(--start-x) + 100vw + 600px)) translateY(var(--wave, 0px)); }
    }

    /* ── Far background clouds — large, very faint ── */
    .cloud-bg-1 {
      --start-x: -600px;
      --drift-dur: 80s;
      --cloud-opacity: 0.18;
      --cloud-blur: 22px;
      --wave: 4px;
      width: 500px; height: 130px;
      top: 20vh;
      left: -600px;
      background: radial-gradient(ellipse at 50% 60%, rgba(100, 160, 215, 0.55) 0%, transparent 75%);
    }

    .cloud-bg-2 {
      --start-x: -800px;
      --drift-dur: 95s;
      --cloud-opacity: 0.14;
      --cloud-blur: 28px;
      --wave: -6px;
      width: 680px; height: 160px;
      top: 55vh;
      left: -800px;
      animation-delay: -38s;
      background: radial-gradient(ellipse at 50% 55%, rgba(80, 140, 200, 0.5) 0%, transparent 70%);
    }

    /* ── Mid-layer clouds ── */
    .cloud-mid-1 {
      --start-x: -420px;
      --drift-dur: 52s;
      --cloud-opacity: 0.38;
      --cloud-blur: 14px;
      --wave: 10px;
      width: 340px; height: 90px;
      top: 32vh;
      left: -420px;
      animation-delay: -12s;
      background: radial-gradient(ellipse at 45% 55%, rgba(140, 195, 235, 0.70) 0%, rgba(90, 150, 210, 0.40) 50%, transparent 75%);
    }

    .cloud-mid-1::before {
      width: 160px; height: 100px;
      top: -45px; left: 60px;
      background: radial-gradient(ellipse at 50% 60%, rgba(155, 205, 240, 0.70) 0%, transparent 70%);
    }

    .cloud-mid-1::after {
      width: 120px; height: 80px;
      top: -30px; left: 160px;
      background: radial-gradient(ellipse at 50% 60%, rgba(140, 195, 235, 0.60) 0%, transparent 70%);
    }

    .cloud-mid-2 {
      --start-x: -550px;
      --drift-dur: 65s;
      --cloud-opacity: 0.32;
      --cloud-blur: 16px;
      --wave: -8px;
      width: 420px; height: 110px;
      top: 68vh;
      left: -550px;
      animation-delay: -28s;
      background: radial-gradient(ellipse at 48% 58%, rgba(120, 180, 225, 0.65) 0%, rgba(70, 130, 195, 0.35) 55%, transparent 75%);
    }

    .cloud-mid-2::before {
      width: 190px; height: 115px;
      top: -52px; left: 75px;
      background: radial-gradient(ellipse at 50% 60%, rgba(135, 190, 230, 0.65) 0%, transparent 70%);
    }

    .cloud-mid-2::after {
      width: 150px; height: 95px;
      top: -35px; left: 200px;
      background: radial-gradient(ellipse at 50% 60%, rgba(125, 185, 228, 0.55) 0%, transparent 70%);
    }

    /* ── Foreground clouds — denser, faster, more visible ── */
    .cloud-fg-1 {
      --start-x: -350px;
      --drift-dur: 38s;
      --cloud-opacity: 0.60;
      --cloud-blur: 8px;
      --wave: 12px;
      width: 280px; height: 72px;
      top: 44vh;
      left: -350px;
      animation-delay: -6s;
      background: radial-gradient(ellipse at 45% 58%, rgba(165, 210, 245, 0.80) 0%, rgba(115, 170, 220, 0.50) 50%, transparent 75%);
    }

    .cloud-fg-1::before {
      width: 130px; height: 88px;
      top: -40px; left: 50px;
      background: radial-gradient(ellipse at 50% 60%, rgba(175, 215, 248, 0.80) 0%, transparent 70%);
    }

    .cloud-fg-1::after {
      width: 100px; height: 70px;
      top: -28px; left: 140px;
      background: radial-gradient(ellipse at 50% 60%, rgba(165, 210, 245, 0.75) 0%, transparent 70%);
    }

    .cloud-fg-2 {
      --start-x: -480px;
      --drift-dur: 45s;
      --cloud-opacity: 0.52;
      --cloud-blur: 10px;
      --wave: -14px;
      width: 360px; height: 92px;
      top: 78vh;
      left: -480px;
      animation-delay: -20s;
      background: radial-gradient(ellipse at 46% 56%, rgba(155, 205, 242, 0.78) 0%, rgba(100, 160, 215, 0.45) 55%, transparent 75%);
    }

    .cloud-fg-2::before {
      width: 165px; height: 105px;
      top: -48px; left: 65px;
      background: radial-gradient(ellipse at 50% 60%, rgba(165, 210, 245, 0.78) 0%, transparent 70%);
    }

    .cloud-fg-2::after {
      width: 130px; height: 85px;
      top: -32px; left: 185px;
      background: radial-gradient(ellipse at 50% 60%, rgba(155, 205, 242, 0.70) 0%, transparent 70%);
    }

    /* ── Moon-level veil cloud — crosses in front of moon ── */
    .cloud-veil {
      --start-x: -700px;
      --drift-dur: 110s;
      --cloud-opacity: 0.22;
      --cloud-blur: 30px;
      --wave: 0px;
      width: 600px; height: 180px;
      top: 6vh;
      left: -700px;
      animation-delay: -50s;
      background: radial-gradient(ellipse at 50% 55%, rgba(120, 180, 225, 0.60) 0%, transparent 68%);
      z-index: 7;
    }

    /* ─── Scene Content ─── */
    .scene {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      text-align: center;
    }

    /* Spacer to clear moon area */
    .moon-spacer {
      height: 290px;
    }

    .tagline-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      animation: fadeUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    }

    @keyframes fadeUp {
      0%   { opacity: 0; transform: translateY(28px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    .app-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(2.6rem, 6vw, 4.5rem);
      font-weight: 600;
      letter-spacing: 0.12em;
      background: linear-gradient(135deg,
        #cce8ff 0%,
        #a8d4f5 30%,
        #7db9e8 60%,
        #c4e0f8 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: none;
      filter: drop-shadow(0 0 30px rgba(100, 170, 230, 0.45));
    }

    .app-subtitle {
      font-size: clamp(0.95rem, 2vw, 1.15rem);
      font-weight: 300;
      color: var(--text-muted);
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .divider {
      width: 60px;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(120, 185, 230, 0.60), transparent);
      margin: 0.5rem 0;
    }

    .tagline {
      font-size: clamp(1rem, 2.2vw, 1.25rem);
      font-weight: 300;
      color: rgba(195, 225, 250, 0.80);
      max-width: 520px;
      line-height: 1.75;
      letter-spacing: 0.02em;
    }

    .cta-group {
      display: flex;
      gap: 1rem;
      margin-top: 2.5rem;
      flex-wrap: wrap;
      justify-content: center;
      animation: fadeUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
