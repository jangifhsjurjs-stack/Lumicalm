    /* Language selector pill */
    .home-lang-wrap {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(91, 175, 214, 0.18);
      border-radius: 7px;
      padding: 0.28rem 0.6rem;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .home-lang-wrap:focus-within,
    .home-lang-wrap:hover {
      background: rgba(91, 175, 214, 0.12);
      border-color: rgba(91, 175, 214, 0.35);
    }

    .home-lang-icon {
      width: 14px;
      height: 14px;
      color: rgba(140, 185, 225, 0.70);
      flex-shrink: 0;
      pointer-events: none;
