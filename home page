    .btn-primary-cta {
      background: linear-gradient(135deg, #3a7abf, #5bafd6);
      color: #e8f5ff;
      border: none;
      box-shadow:
        0 4px 20px rgba(60, 130, 200, 0.40),
        inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .btn-primary-cta:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow:
        0 8px 35px rgba(60, 130, 200, 0.55),
        inset 0 1px 0 rgba(255,255,255,0.15);
    }

    .btn-secondary-cta {
      background: rgba(91, 175, 214, 0.10);
      color: rgba(190, 225, 250, 0.90);
      border: 1px solid rgba(91, 175, 214, 0.30);
      backdrop-filter: blur(8px);
    }

    .btn-secondary-cta:hover {
      transform: translateY(-3px) scale(1.04);
      background: rgba(91, 175, 214, 0.18);
      border-color: rgba(91, 175, 214, 0.55);
      box-shadow: 0 4px 20px rgba(60, 130, 200, 0.25);
    }

    /* Arrow icon */
    .arrow-icon {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.3s ease;
    }

    .btn-primary-cta:hover .arrow-icon { transform: translateX(4px); }

    /* ─── Feature Badges ─── */
    .features {
      display: flex;
      gap: 0.8rem;
      margin-top: 3.5rem;
      flex-wrap: wrap;
      justify-content: center;
      animation: fadeUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) 1.1s both;
    }

    .feature-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.42rem 1rem;
      border-radius: 50px;
      background: rgba(60, 110, 170, 0.14);
      border: 1px solid rgba(91, 175, 214, 0.20);
      font-size: 0.78rem;
      color: rgba(175, 215, 245, 0.80);
      letter-spacing: 0.04em;
      backdrop-filter: blur(6px);
    }

    .feature-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 6px rgba(91, 175, 214, 0.70);
      animation: dotPulse 2.5s ease-in-out infinite;
    }

    @keyframes dotPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.5; transform: scale(0.7); }
    }

    /* ─── How It Works Visual Section ─── */
    .how-it-works-section {
      margin-top: 3.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      max-width: 680px;
      width: 100%;
      animation: fadeUp 1.6s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
    }

    .how-title-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .how-sub-badge {
      font-family: 'Cinzel', serif;
      font-size: 0.76rem;
      letter-spacing: 0.16em;
      color: rgba(160, 205, 240, 0.75);
      text-transform: uppercase;
      background: rgba(60, 110, 170, 0.12);
      border: 1px solid rgba(91, 175, 214, 0.18);
      padding: 0.35rem 1.1rem;
      border-radius: 50px;
      backdrop-filter: blur(6px);
    }

    .orbit-visual-wrap {
      position: relative;
      width: 180px;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0.5rem 0;
    }

    .mini-orbit-ring {
      position: relative;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      border: 1.5px dashed rgba(91, 175, 214, 0.28);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow:
        0 0 25px rgba(60, 130, 190, 0.12),
        inset 0 0 25px rgba(60, 130, 190, 0.08);
      animation: orbitSpin 60s linear infinite;
    }

    @keyframes orbitSpin {
      0%   { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Counter-rotate inner moon so it stays upright */
    .mini-crescent-moon {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: radial-gradient(circle at 40% 40%, rgba(180, 225, 255, 0.22) 0%, rgba(30, 75, 125, 0.12) 70%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 18px rgba(91, 175, 214, 0.45);
      animation: moonCounterSpin 60s linear infinite;
    }

    @keyframes moonCounterSpin {
      0%   { transform: rotate(0deg); }
      100% { transform: rotate(-360deg); }
    }

    /* 3 Orbit Nodes */
    .orbit-node {
      position: absolute;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: rgba(10, 25, 48, 0.90);
      border: 1px solid rgba(91, 175, 214, 0.50);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 10px rgba(91, 175, 214, 0.60);
    }

    /* Positioning 3 nodes at 0deg (top), 120deg (bottom-right), 240deg (bottom-left) */
    .node-1 {
      top: -8px;
      left: calc(50% - 8px);
    }

    .node-2 {
      bottom: 18px;
      right: 2px;
    }

    .node-3 {
      bottom: 18px;
      left: 2px;
    }

    /* How It Works Steps Grid */
    .how-steps-grid {
      display: flex;
      gap: 0.8rem;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .step-card {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 1.1rem;
      border-radius: 12px;
      background: rgba(10, 25, 48, 0.35);
      border: 1px solid rgba(91, 175, 214, 0.16);
      backdrop-filter: blur(8px);
      transition: all 0.3s ease;
    }

    .step-card:hover {
      background: rgba(91, 175, 214, 0.10);
      border-color: rgba(91, 175, 214, 0.35);
      transform: translateY(-2px);
    }

    .step-num {
      font-family: 'Cinzel', serif;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.08em;
    }

    .step-text {
      font-size: 0.82rem;
      color: rgba(185, 220, 248, 0.85);
      letter-spacing: 0.02em;
    }

    /* ─── How It Works Interactive Panel ─── */
    .how-it-works-section,
    .orbit-visual-wrap,
    .how-sub-badge {
      cursor: pointer;
    }

    .orbit-visual-wrap {
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .orbit-visual-wrap:hover {
      transform: scale(1.06);
    }

    .orbit-visual-wrap:hover .mini-orbit-ring {
      border-color: rgba(91, 175, 214, 0.55);
      box-shadow: 0 0 35px rgba(91, 175, 214, 0.35), inset 0 0 30px rgba(91, 175, 214, 0.20);
    }

    .orbit-visual-wrap:hover .mini-crescent-moon {
      box-shadow: 0 0 24px rgba(140, 205, 245, 0.70);
    }

    /* Trigger Glow Animation on Open */
    .orbit-visual-wrap.trigger-active .mini-orbit-ring {
      animation: orbitSpin 60s linear infinite, triggerPulse 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes triggerPulse {
      0%   { transform: scale(1); box-shadow: 0 0 20px rgba(91, 175, 214, 0.2); }
      50%  { transform: scale(1.08); box-shadow: 0 0 45px rgba(140, 205, 245, 0.6); }
      100% { transform: scale(1); box-shadow: 0 0 25px rgba(60, 130, 190, 0.12); }
    }

    /* Panel Backdrop */
    .how-panel-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(2, 10, 24, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 450ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 100;
    }

    .how-panel-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    /* Centered Navy Glassmorphism Panel */
    .how-panel {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -44%);
      max-width: 580px;
      width: 90vw;
      max-height: 85vh;
      background: rgba(8, 20, 42, 0.88);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(91, 175, 214, 0.22);
      border-radius: 24px;
      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.65),
        0 0 45px rgba(60, 130, 200, 0.22);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      z-index: 101;
      opacity: 0;
      pointer-events: none;
      transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1), opacity 450ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .how-panel.active {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, -50%);
    }

    /* Soft Blue Light Ripple Effect */
    .how-panel::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 26px;
      background: linear-gradient(135deg, rgba(91, 175, 214, 0.30), rgba(60, 130, 200, 0.05), rgba(91, 175, 214, 0.20));
      z-index: -1;
      opacity: 0;
      transition: opacity 600ms ease;
      pointer-events: none;
    }

    .how-panel.active::before {
      opacity: 1;
      animation: rippleGlow 4s ease-in-out infinite alternate;
    }

    @keyframes rippleGlow {
      0%   { opacity: 0.5; filter: blur(4px); }
      100% { opacity: 0.9; filter: blur(8px); }
    }

    .how-panel-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(91, 175, 214, 0.12);
    }

    .how-panel-header-left {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .how-panel-title {
      font-family: 'Cinzel', serif;
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: 0.10em;
      color: rgba(232, 244, 255, 0.95);
    }

    .how-panel-subtitle {
      font-size: 0.74rem;
      color: rgba(140, 185, 225, 0.60);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .how-panel-close {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(91, 175, 214, 0.20);
      color: rgba(180, 215, 245, 0.75);
      cursor: pointer;
      padding: 0.45rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s ease;
    }

    .how-panel-close:hover {
      background: rgba(91, 175, 214, 0.18);
      color: #ffffff;
      transform: rotate(90deg);
    }

    .how-panel-close svg {
      width: 18px;
      height: 18px;
    }

    /* Ready Content Area (Empty for future content) */
    .how-panel-content {
      flex: 1;
      min-height: 180px;
      padding-top: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      overflow-y: auto;
    }

    /* RTL support */
    [dir="rtl"] .how-panel-header {
      flex-direction: row-reverse;
    }

    /* ─── Bottom-right footer ─── */
    .footer {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      left: auto;
      transform: none;
      z-index: 10;
      font-size: 0.72rem;
      color: rgba(140, 180, 220, 0.40);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      animation: fadeUp 1.6s ease 1.5s both;
    }

    [dir="rtl"] .footer {
      right: auto;
      left: 1.5rem;
    }

    /* ─── Scroll breath indicator ─── */
    .breath-indicator {
      margin-top: 4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      animation: fadeUp 1.6s ease 1.4s both;
    }

    .breath-ring {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1.5px solid rgba(91, 175, 214, 0.35);
      position: relative;
      animation: breathRing 5s ease-in-out infinite;
    }

    .breath-ring::after {
      content: '';
      position: absolute;
      inset: 8px;
      border-radius: 50%;
      background: rgba(91, 175, 214, 0.20);
      animation: breathCore 5s ease-in-out infinite;
    }

    @keyframes breathRing {
      0%, 100% { transform: scale(1);    border-color: rgba(91, 175, 214, 0.30); }
      50%       { transform: scale(1.22); border-color: rgba(91, 175, 214, 0.65); }
    }

    @keyframes breathCore {
      0%, 100% { transform: scale(0.8); opacity: 0.4; }
      50%       { transform: scale(1.2); opacity: 0.9; }
    }

    .breath-text {
      font-size: 0.72rem;
      color: rgba(140, 185, 225, 0.50);
      letter-spacing: 0.20em;
      text-transform: uppercase;
    }

    /* ─── Responsive ─── */
    @media (max-width: 600px) {
      .moon-glow-outer { width: 240px; height: 240px; }
      .moon-glow-mid   { width: 180px; height: 180px; }
      .moon            { width: 120px; height: 120px; }
      .moon-spacer     { height: 220px; }
    }

    /* ─── Shared Top Header ─── */
    .home-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 62px;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      background: rgba(2, 11, 24, 0.55);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(91, 175, 214, 0.10);
    }

    .home-header-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }

    .home-brand-dot {
      width: 26px;
      height: 26px;
      border-radius: 7px;
      background: linear-gradient(135deg, #3a7abf, #6b5bd6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(60, 120, 200, 0.40);
    }

    .home-brand-name {
      font-family: 'Cinzel', serif;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: rgba(200, 230, 255, 0.85);
