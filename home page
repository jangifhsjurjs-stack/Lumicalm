  <script src="lang.js"></script>
  <script>
    // ─── Generate Starfield (Sparse & Irregular) ──────────────────────
    (function() {
      const layer = document.getElementById('stars-layer');
      const count = 110; // Sparse, serene star distribution

      for (let i = 0; i < count; i++) {
        const star = document.createElement('div');
        star.className = 'star';

        const size  = Math.random() * 1.3 + 0.5;  // 0.5–1.8px delicate points
        const x     = Math.random() * 100;
        const y     = Math.random() * 75;          // upper 75% of sky
        const dur   = (Math.random() * 4 + 4.5).toFixed(2); // 4.5–8.5s slow cycle
        const delay = (Math.random() * 7).toFixed(2);
        const opLo  = (Math.random() * 0.08 + 0.03).toFixed(2);
        const opHi  = (Math.random() * 0.35 + 0.20).toFixed(2);

        star.style.cssText = `
          width: ${size}px;
          height: ${size}px;
          top: ${y}%;
          left: ${x}%;
          --twinkle-dur: ${dur}s;
          --twinkle-delay: ${delay}s;
          --op-lo: ${opLo};
          --op-hi: ${opHi};
        `;

        layer.appendChild(star);
      }
    })();

    // ─── Gentle Mouse Parallax on Moon ───────────────────────────────
    (function() {
      const moonWrapper = document.getElementById('moon-wrapper');
      let targetX = 0, targetY = 0, currentX = 0, currentY = 0;
      document.addEventListener('mousemove', (e) => {
        const cx = window.innerWidth  / 2;
        const cy = window.innerHeight / 2;
        targetX = (e.clientX - cx) / cx * 10;
        targetY = (e.clientY - cy) / cy * 6;
      });
      function animate() {
        currentX += (targetX - currentX) * 0.03;
        currentY += (targetY - currentY) * 0.03;
        moonWrapper.style.marginLeft = `${currentX}px`;
        moonWrapper.style.marginTop  = `${currentY}px`;
        requestAnimationFrame(animate);
      }
      animate();
    })();

    // ─── Language System ─────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
      LunicalmLang.init();

      // Populate select
      const sel = document.getElementById('lang-select-home');
      LUNICALM_LANGUAGES.forEach(lang => {
        const opt = document.createElement('option');
        opt.value = lang.code;
        opt.textContent = lang.name;
        if (lang.code === LunicalmLang.current) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener('change', e => LunicalmLang.apply(e.target.value));
    });

    // ─── Hamburger Nav Drawer ─────────────────────────────────────────
    (function() {
      const drawer   = document.getElementById('home-nav-drawer');
      const backdrop = document.getElementById('home-nav-backdrop');
      const openBtn  = document.getElementById('home-hamburger-btn');
      const closeBtn = document.getElementById('home-nav-close');

      function openDrawer() {
        drawer.classList.add('open');
        backdrop.classList.add('active');
        openBtn.setAttribute('aria-expanded', 'true');
      }
      function closeDrawer() {
        drawer.classList.remove('open');
        backdrop.classList.remove('active');
        openBtn.setAttribute('aria-expanded', 'false');
      }

      openBtn.addEventListener('click', openDrawer);
      closeBtn.addEventListener('click', closeDrawer);
      backdrop.addEventListener('click', closeDrawer);
      window.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
    })();

    // ─── How It Works Panel Controller ────────────────────────────────
    (function() {
      const triggerSection = document.querySelector('.how-it-works-section');
      const orbitWrap = document.querySelector('.orbit-visual-wrap');
      const panel = document.getElementById('how-panel');
      const backdrop = document.getElementById('how-panel-backdrop');
      const closeBtn = document.getElementById('how-panel-close');

      if (!triggerSection || !panel || !backdrop) return;

      function openPanel() {
        if (orbitWrap) {
          orbitWrap.classList.add('trigger-active');
          setTimeout(() => orbitWrap.classList.remove('trigger-active'), 1200);
        }
        backdrop.classList.add('active');
        panel.classList.add('active');
      }

      function closePanel() {
        backdrop.classList.remove('active');
        panel.classList.remove('active');
      }

      triggerSection.addEventListener('click', openPanel);
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          closePanel();
        });
      }
      backdrop.addEventListener('click', closePanel);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel.classList.contains('active')) {
          closePanel();
        }
      });
    })();
  </script>
