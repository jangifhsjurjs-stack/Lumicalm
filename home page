      border-color: rgba(91, 175, 214, 0.18);
      color: #e8f4ff;
    }

    .home-nav-link svg {
      width: 17px;
      height: 17px;
      flex-shrink: 0;
      opacity: 0.65;
    }

    .home-nav-divider {
      height: 1px;
      background: rgba(91, 175, 214, 0.10);
      margin: 0.75rem 0;
    }

    /* Push moon-spacer down to clear header */
    .moon-spacer { margin-top: 62px; }

    /* RTL nav drawer stays on right */
    [dir="rtl"] .home-nav-drawer {
      right: 0;
      left: auto;
      border-left: 1px solid rgba(91, 175, 214, 0.12);
      border-right: none;
    }

    @media (max-width: 400px) {
      .home-lang-wrap { display: none; }  /* collapse on very small screens */
    }
  </style>
