    /* Hamburger on homepage */
    .home-hamburger-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(91, 175, 214, 0.15);
      border-radius: 7px;
      color: rgba(160, 205, 240, 0.80);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.45rem;
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .home-hamburger-btn:hover {
      background: rgba(91, 175, 214, 0.15);
      border-color: rgba(91, 175, 214, 0.35);
      color: #e8f4ff;
    }

    .home-hamburger-btn svg {
      width: 20px;
      height: 20px;
    }

    /* App-nav overlay (slide from right) */
    .home-nav-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 8, 20, 0.70);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 280ms ease;
      z-index: 50;
    }

    .home-nav-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    .home-nav-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: 280px;
      max-width: 85vw;
      height: 100vh;
      background: rgba(4, 14, 30, 0.96);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-left: 1px solid rgba(91, 175, 214, 0.12);
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      z-index: 51;
      transform: translateX(100%);
      transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .home-nav-drawer.open {
      transform: translateX(0);
    }

    .home-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .home-nav-title {
      font-family: 'Cinzel', serif;
      font-size: 0.85rem;
      letter-spacing: 0.14em;
      color: rgba(160, 205, 240, 0.70);
      text-transform: uppercase;
    }

    .home-nav-close {
      background: transparent;
      border: none;
      color: rgba(140, 185, 225, 0.60);
      cursor: pointer;
      padding: 0.4rem;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease, background 0.2s ease;
    }

    .home-nav-close:hover {
      color: #e8f4ff;
      background: rgba(91, 175, 214, 0.12);
    }

    .home-nav-close svg {
      width: 18px;
      height: 18px;
    }

    .home-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      list-style: none;
    }

    .home-nav-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      text-decoration: none;
      color: rgba(175, 215, 245, 0.75);
      font-size: 0.9rem;
      font-weight: 500;
